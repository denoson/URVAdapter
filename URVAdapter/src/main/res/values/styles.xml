<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="FullScreenDialogDark" parent="Theme.AppCompat.Dialog">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">#121212</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B3B3B3</item>
        <item name="colorAccent">#FFBF85</item>
    </style>

    <style name="URVDarkDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">#131B26</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#C1C1C1</item>

        <!-- Принудительно задаем стиль для кнопок -->
        <item name="buttonBarPositiveButtonStyle">@style/URVDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/URVDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/URVDialogButton</item>
    </style>

    <!-- Отдельный стиль для текста самой кнопки -->
    <style name="URVDialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#FFBB00</item> <!-- Ваш нужный цвет -->
        <item name="android:textAllCaps">true</item>
    </style>

</resources>