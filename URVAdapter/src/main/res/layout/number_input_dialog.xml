<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_digits"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/d_number_display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/edittext_background"
            android:gravity="end"
            android:padding="12dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <Button
            android:id="@+id/d_btn_backspace"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="⌫" />

        <Button
            android:id="@+id/d_btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="C" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="3">

        <Button
            android:id="@+id/d_btn_7"
            android:layout_width="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="7" />

        <Button
            android:id="@+id/d_btn_8"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="8" />

        <Button
            android:id="@+id/d_btn_9"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="9" />

        <Button
            android:id="@+id/d_btn_4"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="4" />

        <Button
            android:id="@+id/d_btn_5"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="5" />

        <Button
            android:id="@+id/d_btn_6"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="6" />

        <Button
            android:id="@+id/d_btn_1"
            android:layout_row="2"
            android:layout_column="0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="1" />

        <Button
            android:id="@+id/d_btn_2"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="2" />

        <Button
            android:id="@+id/d_btn_3"
            android:layout_row="2"
            android:layout_column="2"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="3" />

        <Button
            android:id="@+id/d_btn_negative"
            android:layout_row="0"
            android:layout_column="3"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="±" />

        <Button
            android:id="@+id/d_btn_0"
            android:layout_row="2"
            android:layout_column="3"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="0" />

        <Button
            android:id="@+id/d_btn_decimal"
            android:layout_row="1"
            android:layout_column="3"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="." />


    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="right"
        android:orientation="horizontal">

        <Button
            android:id="@+id/d_btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="@android:string/cancel" />

        <Button
            android:id="@+id/d_btn_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="4"
            android:text="@android:string/ok" />
    </LinearLayout>


</LinearLayout>